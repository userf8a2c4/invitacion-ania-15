# ══════════════════════════════════════════════════════════════════════
# .HTACCESS DEL PANEL · QUÉ SE PUEDE PEDIR DESDE EL NAVEGADOR
# ══════════════════════════════════════════════════════════════════════
#
# QUÉ HACE ESTE ARCHIVO
# El .htaccess de la raíz ya protege el .env y comprime todo. Este suma
# las reglas que solo tienen sentido dentro de /admin/, y que si faltan
# dejan datos privados al alcance de cualquiera que escriba la URL.
#
# LAS TRES COSAS QUE CIERRA
#   1. Las librerías internas de api/_lib/ (traen las contraseñas).
#   2. La carpeta archivos/ (contratos y comprobantes escaneados).
#   3. El migracion.sql, que describe la base entera.
# ══════════════════════════════════════════════════════════════════════

# ─── Las librerías internas no se piden por URL ────────────────────────
# api/_lib/bd.php no debe poder abrirse en el navegador: se incluye desde
# los endpoints y nada más. Sin esta regla, un error de PHP mostrado en
# pantalla podría filtrar la contraseña de la base de datos.
RedirectMatch 404 ^/admin/api/_lib/

# ─── Los archivos subidos NO se sirven directo ─────────────────────────
# Se piden por api/archivos.php?id=… que exige sesión. Si se pudieran
# bajar por su URL, un contrato con datos personales quedaría público
# para quien adivinara el nombre.
RedirectMatch 404 ^/admin/archivos/

# ─── Archivos de trabajo que no tienen por qué servirse ────────────────
<FilesMatch "\.(sql|md|log|bak|ini)$">
  Require all denied
</FilesMatch>

# Cualquier cosa que empiece con punto, igual que en la raíz.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ─── Las respuestas de la API nunca se cachean ─────────────────────────
# Es la misma idea que el no-store que manda responder.php, pero puesta
# también acá por si algún intermediario ignora la cabecera de PHP. Si el
# panel cacheara la lista de invitados, mostraría datos viejos y parecería
# que la base de datos no se actualiza.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

  # El armazón de la app sí revalida contra el servidor, igual que en la
  # raíz: así un cambio de código se ve con una sola recarga.
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # El panel no debe poder incrustarse en un iframe ajeno: eso es lo que
  # permite engañar a alguien para que haga clic en algo que no ve.
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"

  # ─── HSTS: que el navegador no vuelva a hablar por HTTP ──────────────
  #
  # Sin esto, la PRIMERA petición de una sesión puede salir en claro —y
  # ahí viaja el token del panel—. Basta una red hostil (un wifi de
  # cafetería) para interceptarla antes de que TLS entre en juego. Con
  # HSTS, el navegador recuerda que este sitio es solo HTTPS y ni lo
  # intenta.
  #
  # Sin `includeSubDomains` a propósito: esa palabra afectaría a TODOS
  # los subdominios de aniaxv.com, incluidos los que no existen todavía,
  # y un año es mucho tiempo para una decisión que no se puede deshacer
  # rápido. Acá el panel es lo que hay que proteger.
  #
  # Sin `preload` por lo mismo: entrar a la lista de precarga de los
  # navegadores es fácil y salir lleva meses.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ─── CSP: de dónde puede salir cada cosa (2026-09-05) ───────────────
  #
  # POR QUÉ
  # Hasta ahora nada impedía que un script inyectado se llevara los datos
  # a otro servidor. El panel maneja nombres, teléfonos, correos y
  # alergias de 115 personas, y desde hoy también cobros.
  #
  # ✅ YA NO ES «Report-Only»: AHORA BLOQUEA DE VERDAD (2026-09-06)
  #
  # Se subió primero en modo Report-Only —que reporta en consola pero no
  # impide nada— porque una CSP mal escrita rompe el panel entero y en
  # silencio, y acá no hay PHP local donde probarla.
  #
  # Se navegó el panel completo en PBE con la consola abierta, incluido
  # lo que más permisos necesita: agregar una tarjeta (que carga
  # js.stripe.com y su iframe) y el mapa de direcciones (Leaflet desde
  # cdnjs y los tiles de OpenStreetMap). CERO violaciones reportadas en
  # los dos casos. Recién con esa prueba hecha se le quitó el sufijo.
  #
  # Si algún día hace falta agregar un origen, conviene volver a
  # `Content-Security-Policy-Report-Only` mientras se comprueba, y
  # recién después dejarlo bloqueando.
  #
  # DE DÓNDE SALE CADA PERMISO (verificado en el código, no supuesto):
  #   · js.stripe.com ......... Stripe.js y el iframe de la tarjeta
  #                             (50-pagos.js:450)
  #   · cdnjs.cloudflare.com .. Leaflet, el mapa de direcciones
  #                             (49-direcciones.js:380 y :384)
  #   · tile.openstreetmap.org  las imágenes de ese mapa (:427)
  #   · blob: ................. el visor de archivos y PDF, que usa
  #                             URL.createObjectURL (06-piezas.js:1368)
  #   · 'unsafe-inline' EN ESTILOS y no en scripts: el JS del panel arma
  #                             HTML con style="…" en 539 sitios. Un
  #                             estilo no ejecuta código; un script sí, y
  #                             ahí no hace falta: index.html no tiene ni
  #                             un <script> inline.
  #
  # `frame-ancestors 'none'` hace lo mismo que X-Frame-Options, que se
  # deja igual para navegadores viejos.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://*.stripe.com https://cdnjs.cloudflare.com; frame-src https://js.stripe.com https://hooks.stripe.com blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ─── Que Authorization llegue a PHP ────────────────────────────────────
# En muchos Apache con PHP como CGI, el encabezado Authorization se pierde
# antes de llegar al script — y como el panel manda ahí el token, TODA
# petición respondería "tu sesión expiró". Esta regla lo vuelve a poner.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ─── Que la app no se caiga al recargar ────────────────────────────────
# El panel es una sola página. Si alguien recarga estando en una vista
# interna, Apache buscaría un archivo que no existe y daría 404; esto
# devuelve siempre el index.html y deja que la app se ubique sola.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/
  RewriteCond %{REQUEST_URI} !^/admin/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /admin/index.html [L]
</IfModule>
