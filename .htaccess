# ══════════════════════════════════════════════════════════════════════
# .HTACCESS · COMPRESIÓN Y CACHÉ DEL SERVIDOR (Hostinger / Apache)
# ══════════════════════════════════════════════════════════════════════
#
# QUÉ HACE ESTE ARCHIVO
# Sin él, el servidor no comprime las respuestas ni les manda al navegador
# instrucciones de cuánto tiempo puede guardarlas en su caché. Esto es lo
# que un diagnóstico de PageSpeed marca como "Use efficient cache
# lifetimes" y también encarece cada visita porque el HTML/CSS/JS viajan
# sin comprimir.
#
# CÓMO SE REPARTE EL CACHÉ, Y POR QUÉ
# Hay tres grupos, y la diferencia entre ellos es UNA sola pregunta:
# ¿este archivo cambia de dirección cuando cambia su contenido?
#
#   1. CSS y JS de la invitación → CACHÉ DE UN AÑO ("immutable").
#      Sí cambian de dirección: se piden como `01-fundamentos.css?v=45`, y
#      al tocarlos se sube ese número (con herramientas/subir-version.mjs).
#      Para el navegador `?v=45` y `?v=46` son archivos distintos, así que
#      se puede guardar el viejo para siempre sin riesgo de que alguien
#      quede con una versión vieja: la próxima vez le vamos a pedir otra
#      dirección. Esto es lo que hace que la web abra al instante en la
#      segunda visita.
#
#      ⚠️ ESTO OBLIGA A CORRER herramientas/subir-version.mjs ANTES DE
#      SUBIR CAMBIOS. Si se sube código sin subir la versión, los que ya
#      habían entrado seguirían viendo lo viejo durante un año y no habría
#      manera de arreglarlo desde el servidor.
#
#   2. index.html y sw.js → SIN CACHÉ, siempre revalidan.
#      NO cambian de dirección: siempre se piden igual. Y son justamente
#      los dos que reparten las direcciones nuevas — el HTML trae los
#      `?v=` y sw.js su propia VERSION. Si se cachearan, nadie se
#      enteraría nunca de que hubo cambios. Son el ancla de todo el
#      sistema.
#
#   3. Imágenes, SVG, audio y tipografías → CACHÉ DE UN AÑO.
#      No llevan versión, pero casi nunca cambian; el día que haya que
#      cambiar alguno, se le pone otro nombre de archivo.
#
# (La carpeta admin/ tiene su propio .htaccess con sus propias reglas: sus
#  archivos NO están versionados, así que allá el caché sigue corto. En
#  Apache, el .htaccess de una subcarpeta manda sobre el de arriba.)
# ══════════════════════════════════════════════════════════════════════

# ─── El juego de caracteres, declarado en la cabecera ───────────────────
# El servidor mandaba `Content-Type: text/html` a secas, sin charset. Un
# navegador lo resuelve mirando el <meta charset> del documento, pero un
# lector estricto —el robot que arma la vista previa de WhatsApp, por
# ejemplo— tiene que adivinar antes de empezar a leer.
#
# index.html además empezaba con un BOM: tres bytes invisibles ANTES del
# <!DOCTYPE html>, que era la otra mitad del mismo problema. Ese ya se
# quitó del archivo; esto cierra el otro lado, declarándolo de una vez
# para todo lo que se sirve.
AddDefaultCharset UTF-8

# ─── Proteger archivos secretos ─────────────────────────────────────────
# Sin esto, cualquiera puede escribir aniaxv.com/.env en el navegador y
# leer la contraseña del correo y la de la base de datos en texto plano.
# Apache no bloquea esos archivos por su cuenta: hay que decírselo.
# Cualquier archivo que empiece con punto (.env, .htaccess, .gitignore…)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Y los archivos de trabajo que tampoco tienen por qué servirse.
# (.mjs = las herramientas de desarrollo, como subir-version.mjs)
<FilesMatch "\.(env|md|sql|log|mjs)$">
  Require all denied
</FilesMatch>

# package.json/package-lock.json (de terser, para minificar-js.mjs) no
# esconden nada secreto, pero tampoco hay motivo para que se puedan pedir
# desde afuera. node_modules/ ni se sube (está en .gitignore), esto es
# nomás por las dudas de que alguna vez se suba sin querer.
<FilesMatch "^package(-lock)?\.json$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^node_modules/ - [F,L]
</IfModule>

# ─── Rutas que este sitio no tiene ──────────────────────────────────────
# Todos los días llegan escaneos automáticos buscando WordPress: prueban
# wp-login.php, xmlrpc.php, carpetas de plugins, un .git expuesto, un
# vendor/ de Composer que se subió por error. Nada de eso existe acá, pero
# sin esta regla cada intento igual arranca PHP para terminar en un 404.
#
# Se corta ANTES: RewriteRule con [F] responde 403 y Apache ni llama a
# PHP. Eso es lo que separa un registro lleno de un servidor cansado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wp-admin        - [F,L]
  RewriteRule ^wp-login\.php$  - [F,L]
  RewriteRule ^wp-content      - [F,L]
  RewriteRule ^wp-includes     - [F,L]
  RewriteRule ^xmlrpc\.php$    - [F,L]
  RewriteRule (^|/)\.git       - [F,L]
  RewriteRule (^|/)vendor/     - [F,L]
  RewriteRule phpinfo          - [F,L]
</IfModule>

# ─── Que nadie liste una carpeta sin index ──────────────────────────────
Options -Indexes

# ─── Compresión (gzip/brotli) ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ─── Cache-Control por tipo de archivo ──────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # CSS y JS: van versionados con ?v=NN, así que se pueden guardar un año.
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"

  # El HTML y el manifiesto NO llevan versión: siempre se revalidan.
  ExpiresByType text/html                  "access plus 0 seconds"
  ExpiresByType application/manifest+json  "access plus 0 seconds"

  # Assets pesados y estables: cache largo, casi nunca cambian.
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/webp      "access plus 1 year"
  ExpiresByType image/x-icon    "access plus 1 year"
  ExpiresByType audio/mpeg      "access plus 1 year"
  ExpiresByType font/woff       "access plus 1 year"
  ExpiresByType font/woff2      "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>

  # ⚠️ EL ORDEN DE ESTOS BLOQUES IMPORTA Y NO SE PUEDE CAMBIAR.
  # "Header set" PISA lo que haya puesto una regla anterior. Así que
  # primero va la regla general (cachear todo el CSS y JS un año) y
  # DESPUÉS las excepciones, que son las que tienen que ganar.

  # ─── Regla general: CSS y JS, un año ────────────────────────────────
  # Seguro porque van versionados con ?v=NN (ver la explicación de arriba).
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ─── Excepción 1: el HTML ───────────────────────────────────────────
  # No lleva ?v= (es la dirección que la gente escribe), y además es quien
  # reparte los ?v= nuevos. Si se cacheara, nadie vería jamás un cambio.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ─── Excepción 2: el service worker ─────────────────────────────────
  # index.html lo registra como 'sw.js' a secas, sin ?v=. Si se cacheara,
  # los visitantes quedarían atrapados con un service worker viejo y sin
  # ninguna vía para actualizarse. Es la excepción más importante.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ─── Assets estables: cache largo e "immutable" ─────────────────────
  # El navegador ni pregunta. Para cambiar alguno, hay que renombrarlo.
  <FilesMatch "\.(svg|jpg|jpeg|png|webp|ico|mp3|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ─── La imagen de la tarjeta NO se puede convertir ───────────────────
  #
  # ⚠️ ESTO ES LO QUE HACÍA QUE EL ENLACE SALIERA PELADO (2026-09-04).
  #
  # El CDN de Hostinger convierte las imágenes a WebP al vuelo cuando
  # quien las pide dice que acepta WebP. Para un navegador es una mejora
  # gratis. Para el robot que arma la vista previa de WhatsApp, no: pide
  # la imagen mandando `Accept: image/webp`, recibe WebP, y **WhatsApp no
  # arma la tarjeta con WebP**. La URL termina en .jpg, la etiqueta
  # og:image declara un JPEG, y lo que llega es otra cosa.
  #
  # Costó encontrarlo porque no se ve en el HTML ni en el archivo: hay
  # que pedir la imagen CON esa cabecera para que el CDN la cambie. Sin
  # ella devuelve el JPEG original y parece que está todo bien.
  #
  # `no-transform` es la forma estándar de decirle a cualquier
  # intermediario que ese archivo se sirve tal cual. Va SOLO para esta
  # imagen: para el resto del sitio, la conversión a WebP es una ventaja
  # y se deja como está.
  <Files "vista-previa-compartir.jpg">
    Header set Cache-Control "public, max-age=31536000, no-transform"
  </Files>

  # ─── Cabeceras de seguridad ──────────────────────────────────────────
  # Mismo criterio que admin/.htaccess. X-Frame-Options en DENY evita que
  # la invitación se cargue dentro de un <iframe> ajeno (clickjacking);
  # nosniff evita que el navegador adivine un tipo de archivo distinto al
  # que el servidor dijo; Referrer-Policy evita que la URL completa viaje
  # a otros sitios cuando alguien hace clic en un enlace de acá.
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"

  # ─── HSTS: nunca más por HTTP (2026-09-05) ───────────────────────────
  #
  # Por acá pasa el formulario de confirmación, y ahí un invitado escribe
  # su nombre, su correo, su teléfono y sus alergias. Sin esto, la
  # primera petición de una visita puede salir en claro: basta un wifi
  # público para leerla antes de que TLS entre en juego.
  #
  # Sin `includeSubDomains` ni `preload` a propósito, igual que en
  # admin/.htaccess: los dos son decisiones que afectan a subdominios que
  # aún no existen y que llevan meses deshacer.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ── CSP · generada por herramientas/csp-publica.mjs ──
  #
  # NO SE EDITA A MANO. El hash de un <script> en línea es de sus bytes
  # exactos, y el cuarto de index.html lleva 24 referencias `?v=`: cambia
  # en cada subida de versión. Se regenera con:
  #     node herramientas/csp-publica.mjs
  # y la tanda de pruebas falla si quedó viejo.
  #
  # Para pasar de mirar a bloquear (o al revés) se cambia el NOMBRE de
  # la cabecera de acá abajo: quitarle o ponerle «-Report-Only». El
  # generador respeta el que encuentre y nunca lo cambia solo.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'sha256-KIyA+EscNp4ORlXAFMq9ZZZyhfCvuyassOHEb/H3R9g=' 'sha256-jna+631sWo6kva7goUGfz5U/HwHpL3HslpCqAbCEkoY=' 'sha256-dM5hRlh2SXVXyd/nrkY96ukBU5VqKEq9mFFk0aTjy1U=' 'sha256-yBY9HUqYgQNAAPDdddZAGApVe8ll0u6Z+MK1x0nzvQs=' 'sha256-Q6+BjP8yCArG4Q4/SS24FXHHng7UaTqx4zjp/cZ/w6Y=' 'sha256-doIlGjA9TuqedERrXSI7YkqEEuiW8zlJkaHKlan+sQU=' 'sha256-LuOEpOaO/JrqYfDsjyhFlpAK/ULYnlqB9RdpKxiyIrs=' 'sha256-nhnNKTaBL+EkKZa88esUTNWLgisnF36+gn9P7uxdBGY='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # ── fin de la CSP generada ──

  # ─── La CSP del sitio público (2026-09-07) ───────────────────────────
  #
  # Acá decía que no había CSP porque los <script> en línea obligarían a
  # poner `unsafe-inline`, el permiso que hace inútil media CSP. Era
  # cierto mientras se escribiera a mano: los siete scripts en línea se
  # cubren con hashes, y el hash es de los bytes exactos, así que el
  # cuarto de index.html —que lleva 24 referencias `?v=`— cambia en cada
  # subida de versión.
  #
  # Por eso el bloque de ARRIBA lo genera una herramienta y no una
  # persona, y subir-version.mjs la corre solo al final de cada ronda —
  # así los hashes no pueden quedar viejos ni olvidándose.
  # Ver herramientas/csp-publica.mjs.
  #
  # Lo que quedó: sin `unsafe-inline` en script-src, sin `unsafe-eval`
  # (no hay un solo eval() en el sitio) y sin `unsafe-hashes` (no hay ni
  # un onclick; todo se engancha con addEventListener).
</IfModule>
